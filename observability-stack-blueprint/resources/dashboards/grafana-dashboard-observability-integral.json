{
  "annotations": { "list": [] },
  "description": "Los datasources Prometheus / Tempo / CloudWatch están ocultos y usan los por defecto de la organización. Logs CloudWatch: mismo nombre que ECS Service en Prometheus → /aws/ecs/<servicio>/app (ej. dmc-lab-obs-demo-java). Con varios servicios seleccionados el panel de logs se repite por servicio. Con ‘All’ algunos entornos Grafana no expanden bien el grupo; si falla, multi-selecciona los servicios en lugar de All. Un solo bloque de filtros: ECS Service, Container (valor por defecto app) y ECS Task (por defecto All; etiquetas Prometheus cuando hay varias tasks). Métricas ECS filtran por los tres. Logs: /aws/ecs/<ECS Service>/app — con varios servicios seleccionados el nombre del grupo puede ser inválido; elige un servicio o All según tus grupos. Traces: mismo ECS Service vía resource.service.name (subcadena); el task ID no se aplica aquí porque muchos spans (p. ej. Faro) no llevan aws.ecs.task.id.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "icon": "dashboard",
      "keepTime": true,
      "title": "Executive health",
      "type": "link",
      "url": "/d/obs-exec-health-v1"
    },
    {
      "icon": "dashboard",
      "keepTime": true,
      "title": "JVM / Spring Boot",
      "type": "link",
      "url": "/d/jvm-otel-springboot"
    },
    {
      "icon": "dashboard",
      "keepTime": true,
      "title": "Faro RUM",
      "type": "link",
      "url": "/d/faro-rum-frontend"
    }
  ],
  "panels": [
    {
      "title": "🟢 Service Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Running Tasks",
      "description": "Cuenta tasks ECS únicos (cluster + servicio + task id), no series por contenedor: cada task suele tener varias series (app, sidecar OTel, etc.) y count() simple las duplicaba.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "targets": [
        {
          "expr": "count(max by (aws_ecs_cluster_name, aws_ecs_service_name, aws_ecs_task_id) (container_cpu_utilized_None{aws_ecs_service_name=~\"$service\", container_name=~\"$container\", aws_ecs_task_id=~\"$ecs_task_id\"}))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "green", "value": null }] } }
      },
      "options": { "colorMode": "background", "textMode": "value" }
    },
    {
      "title": "Service",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "targets": [
        {
          "expr": "count(count by (aws_ecs_service_name) (container_cpu_utilized_None{aws_ecs_service_name=~\"$service\", aws_ecs_task_id=~\"$ecs_task_id\"}))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "blue", "value": null }] } }
      },
      "options": { "colorMode": "background", "textMode": "value" }
    },
    {
      "title": "Cluster",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "targets": [
        {
          "expr": "count(count by (aws_ecs_cluster_name) (container_cpu_utilized_None{aws_ecs_service_name=~\"$service\", aws_ecs_task_id=~\"$ecs_task_id\"}))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "purple", "value": null }] } }
      },
      "options": { "colorMode": "background", "textMode": "value" }
    },
    {
      "title": "Launch Type",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "targets": [
        {
          "expr": "count by (aws_ecs_launchtype) (max by (aws_ecs_cluster_name, aws_ecs_service_name, aws_ecs_task_id, aws_ecs_launchtype) (container_cpu_utilized_None{aws_ecs_service_name=~\"$service\", container_name=~\"$container\", aws_ecs_task_id=~\"$ecs_task_id\"}))",
          "legendFormat": "{{aws_ecs_launchtype}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "orange", "value": null }] } }
      },
      "options": { "colorMode": "background", "textMode": "value_and_name" }
    },
    {
      "title": "📊 Metrics — Container Resources",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "title": "CPU Utilized (%)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "targets": [
        {
          "expr": "container_cpu_utilized_None{aws_ecs_service_name=~\"$service\", container_name=~\"$container\", aws_ecs_task_id=~\"$ecs_task_id\"}",
          "legendFormat": "{{aws_ecs_service_name}} / {{container_name}} / task={{aws_ecs_task_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "fillOpacity": 15, "lineWidth": 2 } }
      }
    },
    {
      "title": "Memory Utilized (MB)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "targets": [
        {
          "expr": "container_memory_utilized_Megabytes{aws_ecs_service_name=~\"$service\", container_name=~\"$container\", aws_ecs_task_id=~\"$ecs_task_id\"}",
          "legendFormat": "{{aws_ecs_service_name}} / {{container_name}} / task={{aws_ecs_task_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "decmbytes", "custom": { "fillOpacity": 15, "lineWidth": 2 } }
      }
    },
    {
      "title": "CPU Usage (vCPU)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "targets": [
        {
          "expr": "container_cpu_usage_vcpu_vCPU{aws_ecs_service_name=~\"$service\", container_name=~\"$container\", aws_ecs_task_id=~\"$ecs_task_id\"}",
          "legendFormat": "{{aws_ecs_service_name}} / {{container_name}} / task={{aws_ecs_task_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 15, "lineWidth": 2 } }
      }
    },
    {
      "title": "Memory Reserved vs Utilized",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "targets": [
        {
          "expr": "container_memory_reserved_Megabytes{aws_ecs_service_name=~\"$service\", container_name=~\"$container\", aws_ecs_task_id=~\"$ecs_task_id\"}",
          "legendFormat": "{{aws_ecs_service_name}} / {{container_name}} — reserved",
          "refId": "A"
        },
        {
          "expr": "container_memory_utilized_Megabytes{aws_ecs_service_name=~\"$service\", container_name=~\"$container\", aws_ecs_task_id=~\"$ecs_task_id\"}",
          "legendFormat": "{{aws_ecs_service_name}} / {{container_name}} — utilized",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "decmbytes", "custom": { "fillOpacity": 10, "lineWidth": 2 } }
      }
    },
    {
      "title": "Network RX/TX (Bytes/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "targets": [
        {
          "expr": "rate(container_network_io_usage_rx_bytes_Bytes{aws_ecs_service_name=~\"$service\", container_name=~\"$container\", aws_ecs_task_id=~\"$ecs_task_id\"}[5m])",
          "legendFormat": "{{aws_ecs_service_name}} / {{container_name}} — RX",
          "refId": "A"
        },
        {
          "expr": "rate(container_network_io_usage_tx_bytes_Bytes{aws_ecs_service_name=~\"$service\", container_name=~\"$container\", aws_ecs_task_id=~\"$ecs_task_id\"}[5m])",
          "legendFormat": "{{aws_ecs_service_name}} / {{container_name}} — TX",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "fillOpacity": 15, "lineWidth": 2 } }
      }
    },
    {
      "title": "🔍 Traces",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
      "title": "Recent Traces",
      "description": "Filtra por la misma variable ECS Service: resource.service.name coincide por subcadena (OTEL). El selector ECS Task solo afecta métricas Prometheus, no Tempo, para no ocultar trazas sin atributo ECS en el recurso.",
      "type": "table",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "tempo", "uid": "${ds_tempo}" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{resource.service.name =~ \".*$service.*\"}",
          "limit": 20,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "inspect": false } } },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } }
    },
    {
      "title": "📝 Logs — CloudWatch",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "collapsed": false
    },
    {
      "title": "Logs — $service",
      "description": "Grupo /aws/ecs/<ECS Service>/app (us-east-2). El texto del servicio debe coincidir con el segmento del log group en AWS (mismo nombre que aws_ecs_service_name en Prometheus). El panel se repite si eliges varios servicios a la vez. Si con ‘All’ no ves datos, multi-selecciona todos los servicios en el filtro en lugar de All.",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 38 },
      "repeat": "service",
      "repeatDirection": "v",
      "maxPerRow": 24,
      "datasource": { "type": "cloudwatch", "uid": "${ds_cloudwatch}" },
      "targets": [
        {
          "queryMode": "Logs",
          "logGroups": [
            {
              "arn": "",
              "name": "/aws/ecs/$service/app",
              "accountId": ""
            }
          ],
          "expression": "fields @timestamp, @message | sort @timestamp desc | limit 100",
          "refId": "A",
          "region": "us-east-2"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["observability", "integral", "ecs", "otel"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 2,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "ds_prometheus",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 2,
        "includeAll": false,
        "label": "Tempo",
        "multi": false,
        "name": "ds_tempo",
        "options": [],
        "query": "tempo",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 2,
        "includeAll": false,
        "label": "CloudWatch",
        "multi": false,
        "name": "ds_cloudwatch",
        "options": [],
        "query": "cloudwatch",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": { "text": "All", "value": "$__all" },
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "ECS Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": "label_values(container_cpu_utilized_None, aws_ecs_service_name)",
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" }
      },
      {
        "current": { "selected": true, "text": "app", "value": "app" },
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Container",
        "multi": true,
        "name": "container",
        "options": [],
        "query": "label_values(container_cpu_utilized_None{aws_ecs_service_name=~\"$service\"}, container_name)",
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" }
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "ECS Task",
        "multi": false,
        "name": "ecs_task_id",
        "options": [{ "selected": true, "text": "All", "value": "$__all" }],
        "query": "label_values(container_cpu_utilized_None{aws_ecs_service_name=~\"$service\", container_name=~\"$container\"}, aws_ecs_task_id)",
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Observability Stack — Integral Dashboard",
  "uid": "obs-integral-lab-v4"
}
